# Copy this file to .env and adjust. .env is git-ignored and never committed.

ENV=development

# Default: the Postgres from infra/docker-compose.yml, which is what the test
# suite expects. Start it with:
#     docker compose -f ../infra/docker-compose.yml up -d db
DATABASE_URL=postgresql+psycopg://pme:pme@localhost:5432/pme_care
#
# For a Neon database (staging/production), use the POOLED connection string
# with "postgresql" changed to "postgresql+psycopg" so SQLAlchemy picks
# psycopg 3, and keep sslmode=require:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Firebase
FIREBASE_PROJECT_ID=pme-care-dev
# true = skip real Firebase verification; the bearer token IS the firebase_uid.
# It also enables the dev-only account-creation endpoints. Only ever true for
# local development and tests — never in production.
AUTH_FAKE_MODE=true

# Comma-separated browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

GCS_BUCKET=pme-care-attachments
